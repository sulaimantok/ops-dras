# Flask
SECRET_KEY=please-change-this-to-a-random-value
# PostgreSQL is the default in Docker Compose. To use an external PostgreSQL
# server, set this full URL and remove/disable the local postgres service.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
POSTGRES_DB=ops_dras
POSTGRES_USER=ops_dras
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DATA_DIR=/opt/data/ops-dras-postgres
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before the app accepts OpenStack passwords or application-credential secrets.
CLUSTER_CREDENTIALS_KEY=

# Set to 0 only for local HTTP development. Production must use HTTPS.
SESSION_COOKIE_SECURE=1
SESSION_LIFETIME_HOURS=8

# Initial admin user (created automatically when it does not exist)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me

# Cluster connection details are entered from the UI and stored encrypted in
# PostgreSQL using CLUSTER_CREDENTIALS_KEY.

# OpenStack call tuning
OPENSTACK_TIMEOUT=30
BACKUP_POLL_INTERVAL=5
BACKUP_POLL_TIMEOUT=1800
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BASE_SECONDS=5
WORKER_POLL_INTERVAL=2

# Login and production validation
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=300
REQUIRE_HTTPS_AUTH_URL=1
