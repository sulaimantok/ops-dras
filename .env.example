# Flask
SECRET_KEY=please-change-this-to-a-random-value
DATABASE_PATH=/app/data/ops-dras.sqlite3

# Initial admin user (only used the first time the SQLite DB is created)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me

# Cluster-A/B connection details (auth URL, username/password or
# application credential, project, etc.) are NOT configured here. Log in
# to the running app and fill them in from the Settings page — they're
# stored in the cluster_config table in SQLite, not in environment vars.

# OpenStack call tuning
OPENSTACK_TIMEOUT=30
BACKUP_POLL_INTERVAL=5
BACKUP_POLL_TIMEOUT=1800
